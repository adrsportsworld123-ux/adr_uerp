# Copy to .env.local (gitignored) and fill in. Used by scripts/local-db.ps1
# (migrations) and scripts/run-local.ps1 (runs the API) against a locally
# installed Postgres instead of docker-compose's.

# --- Admin / schema-owner connection: migrations only, never the API ---
PGADMIN_HOST=localhost
PGADMIN_PORT=5432
PGADMIN_DATABASE=erp
PGADMIN_USER=postgres
PGADMIN_PASSWORD=change-me
# PSQL=C:\Program Files\PostgreSQL\16\bin\psql.exe

# --- API runtime: must be erp_app (non-superuser, RLS enforced; created by migrations/004) ---
DATABASE_DSN=postgres://erp_app:erp_app_password@localhost:5432/erp?sslmode=disable
HTTP_ADDR=:8081
JWT_SECRET=change-me-to-a-long-random-string
DEV_AUTH_TOOLS_ENABLED=true
